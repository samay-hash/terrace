# --- Required ---
NODE_ENV=development
PORT=4000
# Local: mongodb://127.0.0.1:27017/terrace   Atlas: mongodb+srv://user:pass@cluster/terrace
MONGODB_URI=mongodb://127.0.0.1:27017/terrace
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Comma-separated origins allowed to call the API (the storefront URL)
CLIENT_ORIGIN=http://localhost:5173
# 1 when running behind Render / a reverse proxy
TRUST_PROXY=0
# lax when the storefront proxies /api (recommended); none for a cross-site setup
COOKIE_SAMESITE=lax

# --- Image uploads (required in production; local disk is used in development if unset) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=terrace/products

# --- Assistant (optional; Chotu uses its rule-based mode without a key) ---
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5

# --- Seed script only: demo accounts ---
SEED_ADMIN_EMAIL=admin@terrace.test
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=fan@terrace.test
SEED_CUSTOMER_PASSWORD=
